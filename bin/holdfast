#!/usr/bin/env node
'use strict';

// Holdfast CLI: start | status | install | uninstall | help
// Flags set env vars before config loads, so `--minutes 30` == HOLDFAST_HOLD_MINUTES=30.

const path = require('path');

// --- parse flags into env BEFORE requiring config ---
const argv = process.argv.slice(2);
const cmd = argv[0] && !argv[0].startsWith('-') ? argv[0] : 'start';

function flag(name) {
  const i = argv.indexOf(name);
  return i !== -1 && argv[i + 1] ? argv[i + 1] : null;
}
if (flag('--minutes')) process.env.HOLDFAST_HOLD_MINUTES = flag('--minutes');
if (flag('--port')) process.env.HOLDFAST_PORT = flag('--port');
if (flag('--interval')) process.env.HOLDFAST_RETRY_INTERVAL_MS = String(Number(flag('--interval')) * 1000);

const http = require('http');
const config = require('../src/config');

function help() {
  console.log(`
Holdfast — keep your AI coding session alive through any network drop.

USAGE
  holdfast start [--minutes 180] [--port 8787] [--interval 30]
                        Start the resilient proxy (default command)
  holdfast install [--minutes 180]
                        Copy Holdfast to a stable path and auto-start it on login
                        (macOS launchd / Linux systemd). Options are baked in.
  holdfast uninstall    Remove auto-start (reverts tool routing first)
  holdfast status       Check every listener, and whether it is supervised
  holdfast stop         Stop Holdfast (reverts tool routing first, then frees ports)
  holdfast stats        Lifetime counters: drops caught, sessions saved, per tool/provider
  holdfast doctor       Diagnose whether your tools are ACTUALLY protected
  holdfast claude enable|disable|status
                        Route Claude Code through Holdfast, safely (see below)
  holdfast kiro enable|disable|status
                        Route Kiro chat through Holdfast, safely (see below)
  holdfast help         Show this help

ROUTING YOUR TOOLS (the part that actually protects anything)
  Prefer the managed commands — they refuse to point a tool at Holdfast unless
  Holdfast is installed as a service and the port answers as ours, they back up
  every file they touch, and they revert cleanly:

      holdfast install && holdfast claude enable && holdfast kiro enable

  claude enable writes into ~/.claude/settings.json (env block), which is where
  Claude Code reads it even when a wrapper launches it — an exported shell
  variable never reaches a wrapper-launched Claude Code. In Bedrock mode it
  points at a region-tagged URL so the proxy signs for YOUR region:
      ANTHROPIC_BEDROCK_BASE_URL=http://127.0.0.1:8789/region/<your region>
      CLAUDE_CODE_SKIP_BEDROCK_AUTH=1
  kiro enable writes codewhisperer.config.krsEndpoints in Kiro's user settings,
  for the region in Kiro's profile ARN, then asks you to reload the Kiro window.

  Manual alternative (Anthropic API users): export ANTHROPIC_BASE_URL=http://localhost:8787
  Codex/OpenAI: set the OpenAI base URL to http://localhost:8788  (see README)

  WARNING: pointing a tool at Holdfast WITHOUT installing it means that tool is
  hard-down whenever Holdfast is not running (e.g. you closed the terminal).

CONFIG (env vars, all optional)
  HOLDFAST_HOLD_MINUTES   how long to keep holding   (default 180 = 3 hours)
  HOLDFAST_RETRY_INTERVAL_MS  probe interval ms       (default 30000)
  HOLDFAST_HEARTBEAT_MS   keep-alive ping interval    (default 15000)
  HOLDFAST_BEDROCK_REGION / HOLDFAST_KIRO_REGION      region per listener
  HOLDFAST_AWS_CREDENTIAL_COMMAND  command printing AWS credential JSON
  HOLDFAST_AWS_PROFILE    profile for credential_process / static keys
  HOLDFAST_LISTENERS      JSON array of {name,port,upstream} for multi-provider
  HOLDFAST_LOG_FILE       log path                    (default ~/.holdfast/holdfast.log)

Current: hold ~${config.holdMinutes} min, ${config.listeners.length} listener(s), log ${config.logFile}
`);
}

// Is Holdfast supervised, and from where? A tool routed through an
// unsupervised Holdfast breaks the moment that terminal closes, so this is
// reported with the listeners rather than hidden behind `doctor`.
function reportSupervision() {
  const fs = require('fs');
  const st = require('../src/route').installState();
  if (!st) {
    console.log('• not installed as a service — Holdfast stops when this process does.');
    console.log('  Install (recommended before routing any tool): holdfast install');
    return;
  }
  const exists = fs.existsSync(st.appDir);
  console.log(
    `• supervised by ${st.manager} from ${st.appDir}${exists ? '' : '  ⚠ MISSING — run: holdfast install'}` +
      `  (v${st.version}, hold ${st.env && st.env.HOLDFAST_HOLD_MINUTES} min)`
  );
  for (const [tool, mod] of [['claude', '../src/claudeRoute'], ['kiro', '../src/kiroRoute']]) {
    try {
      if (require(mod).isEnabled()) console.log(`• ${tool} is routed through Holdfast (revert: holdfast ${tool} disable)`);
    } catch (_) {}
  }
}

function status() {
  let pending = config.listeners.length;
  let anyDown = false;
  if (!pending) { console.log('no listeners configured'); return; }
  reportSupervision();

  const settle = (ok) => {
    if (!ok) anyDown = true;
    if (--pending === 0) process.exit(anyDown ? 1 : 0);
  };

  config.listeners.forEach((l) => {
    let done = false;
    const finishOnce = (fn) => { if (done) return; done = true; fn(); };

    const req = http.get(
      { host: '127.0.0.1', port: l.port, path: '/__holdfast/health', timeout: 3000, agent: false },
      (res) => {
        const chunks = [];
        res.on('data', (c) => chunks.push(c));
        res.on('end', () => finishOnce(() => {
          try {
            const info = JSON.parse(Buffer.concat(chunks).toString());
            console.log(`✓ [${l.name}] running on :${l.port} (pid ${info.pid}) → ${info.upstream}`);
          } catch (_) {
            console.log(`✓ [${l.name}] responding on :${l.port}`);
          }
          settle(true);
        }));
      }
    );

    // Any of these ends this listener's check exactly once, so status can never
    // hang: a wedged/old instance that never replies still trips the timeout.
    req.on('timeout', () => {
      req.destroy();
      finishOnce(() => {
        console.log(`✗ [${l.name}] on :${l.port} did not respond in time (old/stuck instance? try: holdfast stop)`);
        settle(false);
      });
    });
    req.on('error', () => finishOnce(() => {
      console.log(`✗ [${l.name}] not responding on :${l.port} — start with: holdfast start`);
      settle(false);
    }));
  });
}

switch (cmd) {
  case 'start':
    require('../src/server').start();
    break;
  case 'status':
    status();
    break;
  case 'stop':
    require('../src/stop').stop();
    break;
  case 'stats': {
    const { snapshot, statsFile } = require('../src/stats');
    const s = snapshot();
    const fmtHeld = (sec) => (sec >= 90 ? `${Math.round(sec / 60)}m` : `${sec}s`);
    const row = (name, b) =>
      console.log(
        `  ${name.padEnd(14)} requests ${String(b.requests).padEnd(7)} drops ${String(b.drops).padEnd(5)} saved ${String(b.saves).padEnd(5)} gave-up ${String(b.giveups).padEnd(4)} time held ${fmtHeld(b.heldSeconds)}`
      );
    console.log(`\nHoldfast lifetime stats (since ${s.since})\n`);
    console.log('By provider:');
    const ls = Object.entries(s.listeners);
    if (ls.length) ls.forEach(([n, b]) => row(n, b)); else console.log('  (no traffic yet)');
    console.log('\nBy client tool:');
    const as = Object.entries(s.agents);
    if (as.length) as.forEach(([n, b]) => row(n, b)); else console.log('  (no traffic yet)');
    console.log(`\n"saved" = a session that WOULD have died to a network drop but was recovered.`);
    console.log(`Raw data: ${statsFile}\n`);
    break;
  }
  case 'install':
    require('../src/autostart').install();
    break;
  case 'uninstall':
    require('../src/autostart').uninstall();
    break;
  case 'doctor':
    require('../src/doctor').run().then((code) => process.exit(code));
    break;
  case 'kiro':
  case 'claude': {
    const mod = require(cmd === 'kiro' ? '../src/kiroRoute' : '../src/claudeRoute');
    const sub = argv[1] && !argv[1].startsWith('-') ? argv[1] : 'status';
    const force = argv.includes('--force');
    if (sub === 'enable') {
      Promise.resolve(mod.enable({ force })).then((code) => process.exit(code || 0));
    } else if (sub === 'disable') {
      process.exit(mod.disable() || 0);
    } else if (sub === 'status') {
      Promise.resolve(mod.status()).then(() => process.exit(0));
    } else {
      console.error(`Unknown "${cmd}" subcommand: ${sub}. Use enable | disable | status.`);
      process.exit(1);
    }
    break;
  }
  case 'help':
  case '-h':
  case '--help':
    help();
    break;
  default:
    console.error(`Unknown command: ${cmd}\n`);
    help();
    process.exit(1);
}
